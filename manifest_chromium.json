{
    "name": "AnnyMusic",
    "version": "0.0.1",
    "description": "兼容洛雪音乐源的音乐播放器（不内置音源）",
    "manifest_version": 3,
    "icons": {
        "64": "./img/icon_64x64.png",
        "128": "./img/icon_128x128.png"
    },
    "permissions": [
        "webRequest",
        "cookies",
        "tabs",
        "scripting",
        "storage",
        "declarativeNetRequest"
    ],
    "host_permissions": [
        "*://*/*"
    ],
    "action": {
        "default_title": "AnnyMusic"
    },
    "background": {
        "service_worker": "./js/background.js"
    }
}
